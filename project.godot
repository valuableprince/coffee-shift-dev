; Coffee Shift prototype — Godot 4.3+
config_version=5

[application]
config/name="Coffee Shift"
run/main_scene="res://scenes/first_shift.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/positional_shadow/atlas_size=1024

[input]

orders={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
inspect_mode={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
notebook={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":78)]
}

; DEV-02 additions; DEV-01 bindings above stay unchanged.
